{
  "name": "SpaceActivity",
  "type": "object",
  "properties": {
    "child_space_id": {
      "type": "string",
      "description": "מזהה המרחב שאליו שייכת הפעילות"
    },
    "activity_slug": {
      "type": "string",
      "description": "מזהה הפעילות בקוד, למשל emotion-wheel. מצביע בלבד — תוכן הפעילות נשאר ב-src/components/activities ולא נשמר כאן"
    },
    "is_favorite": {
      "type": "boolean",
      "default": true,
      "description": "האם הפעילות מוצמדת למדף הפעילויות האהובות"
    },
    "sort_order": {
      "type": "number",
      "description": "סדר ההצגה במדף"
    },
    "last_opened_at": {
      "type": "string",
      "format": "date-time",
      "description": "מתי הפעילות נפתחה לאחרונה מתוך המרחב"
    },
    "open_count": {
      "type": "number",
      "default": 0,
      "description": "כמה פעמים הפעילות נפתחה. מזין את האינסייטים להורים"
    }
  },
  "required": ["child_space_id", "activity_slug"],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        { "created_by_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "update": {
      "$or": [
        { "created_by_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "delete": {
      "$or": [
        { "created_by_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    }
  }
}
