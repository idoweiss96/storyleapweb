{
  "name": "ActivityEntry",
  "type": "object",
  "properties": {
    "child_space_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05de\u05e8\u05d7\u05d1 \u05e9\u05d0\u05dc\u05d9\u05d5 \u05e0\u05e9\u05de\u05e8\u05d4 \u05d4\u05e2\u05d1\u05d5\u05d3\u05d4"
    },
    "activity_slug": {
      "type": "string",
      "description": "\u05d0\u05d9\u05d6\u05d5 \u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05e0\u05e2\u05e9\u05ea\u05d4, \u05dc\u05de\u05e9\u05dc emotion-wheel. \u05d4\u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05e2\u05e6\u05de\u05d4 \u05e0\u05e9\u05d0\u05e8\u05ea \u05d1\u05e7\u05d5\u05d3"
    },
    "summary": {
      "type": "string",
      "description": "\u05e9\u05d5\u05e8\u05d4 \u05d0\u05d7\u05ea \u05e9\u05de\u05ea\u05d0\u05e8\u05ea \u05de\u05d4 \u05d4\u05d9\u05dc\u05d3/\u05d4 \u05e2\u05e9\u05d4/\u05ea\u05d4, \u05dc\u05de\u05e9\u05dc: \u05db\u05e2\u05e1 \u00b7 \u05e2\u05d5\u05e6\u05de\u05d4 7. \u05d6\u05d4 \u05de\u05d4 \u05e9\u05d4\u05d4\u05d5\u05e8\u05d4 \u05e8\u05d5\u05d0\u05d4 \u05d1\u05e4\u05d9\u05d3"
    },
    "payload": {
      "type": "object",
      "description": "\u05e6\u05d9\u05dc\u05d5\u05dd \u05de\u05e6\u05d1 \u05e9\u05dc \u05d4\u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05db\u05d0\u05d5\u05d1\u05d9\u05d9\u05e7\u05d8 JSON, \u05db\u05d3\u05d9 \u05e9\u05d0\u05e4\u05e9\u05e8 \u05d9\u05d4\u05d9\u05d4 \u05dc\u05e4\u05ea\u05d5\u05d7 \u05d5\u05dc\u05d4\u05d3\u05e4\u05d9\u05e1 \u05d0\u05d5\u05ea\u05d4 \u05e9\u05d5\u05d1"
    },
    "snapshot_html": {
      "type": "string",
      "description": "\u05e6\u05d9\u05dc\u05d5\u05dd \u05d4\u05de\u05e8\u05d0\u05d4 \u05e9\u05dc \u05d4\u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05d1\u05e8\u05d2\u05e2 \u05d4\u05e9\u05de\u05d9\u05e8\u05d4, \u05db\u05d3\u05d9 \u05dc\u05d4\u05e6\u05d9\u05d2 \u05d0\u05d5\u05ea\u05d4 \u05db\u05de\u05d5 \u05e9\u05d4\u05d9\u05d0 \u05de\u05d5\u05d3\u05e4\u05e1\u05ea \u05d5\u05dc\u05d0 \u05db\u05e8\u05e9\u05d9\u05de\u05ea \u05e9\u05d3\u05d5\u05ea"
    },
    "image_url": {
      "type": "string",
      "description": "\u05ea\u05de\u05d5\u05e0\u05d4 \u05e9\u05e0\u05d5\u05e6\u05e8\u05d4 \u05d1\u05e4\u05e2\u05d9\u05dc\u05d5\u05ea (\u05e6\u05d9\u05d5\u05e8 \u05d4\u05e8\u05d2\u05e9 \u05dc\u05de\u05e9\u05dc), \u05de\u05d5\u05e2\u05dc\u05d9\u05ea \u05d3\u05e8\u05da Core.UploadFile"
    }
  },
  "required": [
    "child_space_id",
    "activity_slug"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}