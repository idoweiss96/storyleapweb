{
  "name": "MoodEntry",
  "type": "object",
  "properties": {
    "child_space_id": {
      "type": "string",
      "description": "מזהה המרחב שאליו שייך הצ׳ק-אין"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "היום שאליו מתייחס הצ׳ק-אין (YYYY-MM-DD). רשומה אחת ליום למרחב"
    },
    "mood": {
      "type": "number",
      "description": "1 קשה לי, 2 לא כזה טוב, 3 בסדר, 4 טוב, 5 מעולה"
    },
    "note": {
      "type": "string",
      "description": "מה קרה היום, אופציונלי"
    }
  },
  "required": ["child_space_id", "date", "mood"],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        { "created_by_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "update": {
      "$or": [
        { "created_by_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "delete": {
      "$or": [
        { "created_by_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    }
  }
}
