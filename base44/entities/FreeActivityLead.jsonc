{
  "name": "FreeActivityLead",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "Parent's email, left optionally at the end of a free activity"
    },
    "activity": {
      "type": "string",
      "enum": [
        "goodbye_ritual",
        "morning_evening",
        "little_heart"
      ],
      "description": "Which free activity this lead came from"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description"
    }
  },
  "required": [
    "email"
  ],
  "rls": {
    "create": {},
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}