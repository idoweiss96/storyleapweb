{
  "name": "\u05d4\u05ea\u05e8\u05d0\u05ea \u05de\u05d9\u05d9\u05dc \u05e2\u05dc \u05d4\u05d2\u05e9\u05ea \u05e1\u05d9\u05e4\u05d5\u05e8 \u05d7\u05d3\u05e9",
  "description": "",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"payment_status\") != null) and (.trigger.data.payment_status == \"paid\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Story"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "migrated_workflow",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyNewStory",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "notifyNewStory"
  }
}