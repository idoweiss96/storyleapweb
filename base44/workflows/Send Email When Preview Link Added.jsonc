{
  "name": "Send Email When Preview Link Added",
  "description": "Sends the \"preview is ready\" email with the Heyzine flipbook link and continue-purchase button once an admin pastes the preview_link, and marks the preview as ready.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"preview_link\") != null) and (.trigger.data.preview_link != null and .trigger.data.preview_link != \"\" and .trigger.data.preview_link != [] and .trigger.data.preview_link != {})) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "StoryPreview"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "send_email_when_preview_link_added",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "onPreviewLinkAdded",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "onPreviewLinkAdded"
  }
}